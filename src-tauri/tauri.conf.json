{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owler IDE",
  "version": "0.1.0",
  "identifier": "lang.ow.owleride",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owler IDE \u2014 The home for OW",
        "width": 1470,
        "height": 920,
        "minWidth": 980,
        "minHeight": 650,
        "backgroundColor": "#0b0f19"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../vendor/ow/": "ow-toolchain/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
